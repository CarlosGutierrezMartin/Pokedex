{
  "name": "fauna-piloto",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.14.0",
    "npm": "11.9.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "predev": "npm run prepare:runtime",
    "prebuild": "npm run prepare:runtime",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "prepare:models": "node scripts/prepare-models.mjs",
    "probe:t01": "node scripts/probe-t01.mjs",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit && eslint . && npm run check:data && vitest run",
    "check:data": "node --experimental-strip-types scripts/check-data.ts",
    "build": "tsc --noEmit && vite build",
    "preview:local": "node scripts/preview-local.mjs",
    "preview:test": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "dexie": "4.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.12.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
